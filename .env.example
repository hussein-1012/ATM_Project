# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Databases ───────────────────────────────────────────────────────────────
# docker-compose overrides host to `postgres` / `redis`
DATABASE_URL=postgres://aqrab:aqrab@localhost:5432/aqrab
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In production these MUST be set, be >= 32 chars and differ from each other.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-please
JWT_REFRESH_TTL=30d
JWT_RESET_TTL=10m

# ─── CORS / rate limits ──────────────────────────────────────────────────────
CORS_ORIGINS=*
THROTTLE_TTL=60000
THROTTLE_LIMIT=300
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=10
REPORT_THROTTLE_TTL=60000
REPORT_THROTTLE_LIMIT=5

# ─── Password-reset OTP (Redis) ──────────────────────────────────────────────
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# ─── Community reports ───────────────────────────────────────────────────────
REPORT_COOLDOWN_MINUTES=30
REPORT_FRESH_HOURS=6

# ─── Routing ─────────────────────────────────────────────────────────────────
# osrm | ors | fallback  (fallback = straight line, always works)
ROUTING_PROVIDER=fallback
OSRM_URL=https://router.project-osrm.org
ORS_URL=https://api.openrouteservice.org
ORS_API_KEY=
ROUTE_CACHE_TTL_SECONDS=60
ROUTING_TIMEOUT_MS=5000

# ─── Importer ────────────────────────────────────────────────────────────────
IMPORT_DEFAULT_FILE=data/atms.json
