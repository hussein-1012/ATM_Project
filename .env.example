# ─── .NET Backend Environment Variables ──────────────────────────────────────
# These override appsettings.json values (use __ as section separator).
# Copy this file to .env and fill in your actual values. Never commit .env.

# MongoDB
Mongo__ConnectionString=mongodb://localhost:27017
Mongo__DatabaseName=atm_project

# Redis — set to "memory" if you do not have a local Redis server
Redis__ConnectionString=memory

# JWT (generate a secure random key: openssl rand -base64 48)
Jwt__AccessSecret=change-me-access-secret-must-be-at-least-32-characters-long!
Jwt__AccessTtl=15m
Jwt__RefreshTtl=30d
Jwt__ResetTtl=10m

# Email — Sendliberty (Gmail OAuth relay, no domain/DNS setup required)
# Get your key from: https://sendliberty.com → Dashboard → API Keys
# Leave blank to use console fallback (prints to stdout in development)
# Endpoint: POST https://sendliberty.com/api/send
# Auth:     Authorization: Bearer <ApiKey>
Sendliberty__ApiKey=sl_your_api_key_here
# Optional: override sender ("Name <email@gmail.com>")
# Leave empty to use the default connected Gmail account in Sendliberty
# Sendliberty__From=Aqrab Makina Leek <your@gmail.com>

# Routing: fallback | osrm | ors
Routing__Provider=fallback
Routing__OsrmUrl=https://router.project-osrm.org
Routing__OrsUrl=https://api.openrouteservice.org
Routing__TimeoutMs=5000
Routing__CacheTtlSeconds=60

# ASP.NET Core (optional overrides)
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
